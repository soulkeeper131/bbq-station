# BBQ Station — копирай като .env за локално или задай в Coolify Environment.
# Никога не комитвай реални стойности.

# ── Infobip / Viber ──────────────────────────────────────────
INFOBIP_BASE_URL=xxxxx.api.infobip.com
INFOBIP_API_KEY=your-infobip-app-key
INFOBIP_SENDER=IBSelfServe

# ── Приложение ─────────────────────────────────────────────
PORT=3000
MENU_FILE=menu-prototip_8.html
NODE_ENV=production

# Публичен URL на сайта (за тракинг линкове във Viber)
PUBLIC_URL=https://bbqstation.blv.bg

# Постоянно хранилище (volume в Coolify → /data)
DATA_DIR=/data

# Продукция: скрива демо лентата; админ на ?admin=1
DEMO_MODE=false

# Задължителен ключ за админ API (меню, снимки, списък поръчки, смяна статус)
ADMIN_API_KEY=generate-a-long-random-secret

# ── Локален Viber тест (test-viber.mjs) ────────────────────
VIBER_TEST_TO=359888123456
VIBER_TEST_TEXT=Тест от BBQ Station
