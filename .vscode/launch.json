{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 BBQ Station (watch)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "local-server.mjs"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🐛 BBQ Station (debug, no watch)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect", "local-server.mjs"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
